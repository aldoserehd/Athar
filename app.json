{
  "expo": {
    "name": "Athar",
    "slug": "athar",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "athar",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0c465b"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.athar.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Athar uses your location to calculate accurate prayer times and the qibla direction for where you are.",
        "NSCameraUsageDescription": "Athar uses the camera to scan a photo of a hadith and find it in the library.",
        "NSPhotoLibraryUsageDescription": "Athar lets you choose a photo of a hadith to scan and find it in the library."
      }
    },
    "android": {
      "package": "com.athar.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0c465b"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Athar uses your location to calculate accurate prayer times and the qibla direction for where you are."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/adhan/makkah_30.wav",
            "./assets/adhan/arkani_30.wav",
            "./assets/adhan/alafasy_30.wav",
            "./assets/adhan/qatami_30.wav",
            "./assets/adhan/zahrani_30.wav",
            "./assets/adhan/basit_30.wav",
            "./assets/adhan/menshawy_30.wav",
            "./assets/adhan/refaat_30.wav",
            "./assets/adhan/deghreri_30.wav"
          ]
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Athar lets you choose a photo of a hadith to scan and find it in the library.",
          "cameraPermission": "Athar uses the camera to scan a photo of a hadith and find it in the library."
        }
      ],
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "895b0fb8-c545-46d2-876b-fa6674a79159"
      }
    },
    "owner": "abdulrahmanaldousari"
  }
}
